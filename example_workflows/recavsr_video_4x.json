e":"sRGB","chroma_subsampling":"auto","codec":"none"}},{"id":6,"type":"SaveVideo","pos":[1330.487890625,90],"size":[270,557.2213114754097],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"video","name":"video","type":"VIDEO","link":7},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"format","name":"format","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"format"},"link":null},{"localized_name":"codec","name":"format.codec","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"format.codec"},"link":null},{"localized_name":"codec","name":"codec","shape":7,"type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"codec"},"link":null}],"outputs":[{"localized_name":"video","name":"video","type":"VIDEO","links":null}],"properties":{},"widgets_values":["recavsr/video","auto","auto","auto"],"widgets_values_named":{"filename_prefix":"recavsr/video","format":"auto","format.codec":"auto","codec":"auto"}},{"id":7,"type":"MarkdownNote","pos":[60,724.9898101306352],"size":[560,260],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"Read me","properties":{},"widgets_values":["## ReCaVSR video super-resolution\n\nOne-step streaming diffusion VSR built on Wan2.2 TI2V-5B (USTC). 21 frames, then 8 at a time, each block decoded as it is generated.\n\n**Files** (download into `ComfyUI/models/recavsr/`): [kopper/ReCaVSR](https://huggingface.co/kopper/ReCaVSR) `transformer.safetensors`, `prompt.safetensors`, `flashdecoder.safetensors`.\n\n**Settings**: `scale` 4 is what the model was trained for (2 and 1.5 also documented). `color_fix` wavelet or adain matches colours to the input. `decoder` vae uses ComfyUI's Wan 2.2 VAE instead of the FlashDecoder.\n\nCode: [kopperx/ReCaVSR](https://github.com/kopperx/ReCaVSR), paper [arXiv 2609.37831](https://arxiv.org/abs/2609.37831)."],"widgets_values_named":{"text":"## ReCaVSR video super-resolution\n\nOne-step streaming diffusion VSR built on Wan2.2 TI2V-5B (USTC). 21 frames, then 8 at a time, each block decoded as it is generated.\n\n**Files** (download into `ComfyUI/models/recavsr/`): [kopper/ReCaVSR](https://huggingface.co/kopper/ReCaVSR) `transformer.safetensors`, `prompt.safetensors`, `flashdecoder.safetensors`.\n\n**Settings**: `scale` 4 is what the model was trained for (2 and 1.5 also documented). `color_fix` wavelet or adain matches colours to the input. `decoder` vae uses ComfyUI's Wan 2.2 VAE instead of the FlashDecoder.\n\nCode: [kopperx/ReCaVSR](https://github.com/kopperx/ReCaVSR), paper [arXiv 2609.37831](https://arxiv.org/abs/2609.37831)."},"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,2,0,"VIDEO"],[2,3,0,4,0,"RECAVSR"],[3,2,0,4,1,"IMAGE"],[4,4,0,5,0,"IMAGE"],[5,2,1,5,1,"AUDIO"],[6,2,2,5,2,"FLOAT"],[7,5,0,6,0,"VIDEO"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.3278464585752342,"offset":[200.87580673688484,459.8744089084809]}},"version":0.4}